FROM python:3.12-slim

WORKDIR /app

# Install CPU-only torch first (avoids pulling ~8GB of CUDA libs)
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir beautifulsoup4 pydantic[email] \
    && pip install --no-cache-dir -r requirements.txt

# Copy the b4igo_email_agent package (needed for pipeline)
COPY b4igo_email_agent/ b4igo_email_agent/

# Copy the ingest script
COPY demo/mail_ingest.py .

CMD ["python", "mail_ingest.py"]
