FROM node:20-slim

WORKDIR /app

# Install dependencies
COPY b4igo_email_agent_frontend/package.json b4igo_email_agent_frontend/package-lock.json* ./
RUN npm install

# Copy frontend source
COPY b4igo_email_agent_frontend/ .

EXPOSE 5173

# Run vite dev server bound to all interfaces so Docker can expose it
CMD ["npx", "vite", "--host", "0.0.0.0"]
